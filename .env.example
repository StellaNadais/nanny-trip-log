# Must match NANNY_SYNC_CODE in Vercel. Use a long, randomly generated shared code.
VITE_NANNY_SYNC_CODE=replace-with-a-long-random-shared-code

# Server-only Vercel environment variables (do not put these in a client .env file):
# NANNY_SYNC_CODE=replace-with-the-same-long-random-shared-code
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...
