# Supabase Project Settings → API. These values are safe to expose to the browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# A unique shared household code (at least 24 characters). Use the exact same value
# on the nanny device and every family device that should share this week's data.
VITE_NANNY_SYNC_CODE=replace-with-a-long-random-shared-code
