{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "carekidsmiles.com" }],
      "destination": "https://www.nannytriplog.com/book",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.carekidsmiles.com" }],
      "destination": "https://www.nannytriplog.com/book",
      "permanent": false
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
